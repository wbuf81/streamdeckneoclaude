node_modules/
dist/
*.log

# Runtime state lives outside the repo, but never commit it by accident.
# It holds the Spotify refresh token.
state/
*.local.json
spotify.json

# The REAL user configuration. It lives at ~/.local/state/deckd/config.json,
# outside this repository, and nothing here reads a copy inside it -- these
# rules exist only so that a copy taken for editing or debugging cannot be
# committed. It holds the Spotify client id, the home ZIP code, and the
# address of a device on a private network.
#
# `config.example.json` is deliberately NOT matched: the leading slash pins
# these to the repository root and to that exact name, so the committed
# example stays tracked.
/config.json
/config.*.json
!/config.example.json

.DS_Store
.vscode/
.idea/

# C1's child-process probe test (tests/render/canvas.test.ts) writes its
# esbuild-bundled scratch files here, inside the project so Node's ESM
# resolver finds node_modules — cleaned up in the test's own `finally`, this
# is only a backstop against a run that dies before cleanup.
.c1-probe-*/

# SDD scratch: ledger, briefs, review packages. Not part of the project.
.superpowers/

